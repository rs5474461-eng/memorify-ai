# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# LYRIA_API_KEY: Optional API key for Google DeepMind Lyria 3.5 Music Generation API.
# If unavailable or empty, Memorify AI automatically switches to the Development Audio Synthesis Engine.
LYRIA_API_KEY=DEFAULT_LYRIA_KEY
